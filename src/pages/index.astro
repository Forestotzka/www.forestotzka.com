---
import { getPosts } from '../data/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = getPosts().sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">WELCOME</p>
    <h1>えありぷの森</h1>
    <p>いろんな記事を書いています。</p>
    <a class="button" href="/posts/">記事を読む</a>
  </section>
  <section class="section-heading">
    <div>
      <p class="eyebrow">RECENT POSTS</p>
      <div class="recent-posts-header">
        <h2>最近の記事</h2>
        <a href="/posts/">すべて見る →</a>
      </div>
    </div>
  </section>
  <div class="post-grid">
    {posts.slice(0, 3).map((post) => <PostCard post={post} eager />)}
  </div>
</BaseLayout>
